#!/usr/bin/env bash
# Generate the system config files from camshare.conf.
#
# udev rule and module options are derived rather than checked in, so the config
# stays the single source of truth for how many virtual cameras exist and what
# they are called. Print to stdout; the Makefile pipes them through sudo tee.
set -uo pipefail

HERE=$(dirname "$(readlink -f "$0")")
# shellcheck source=/dev/null
. "$HERE/camshare-conf"
camshare_conf_load || { echo "camgen: no config found" >&2; exit 1; }

need() {
    [ -n "${!1}" ] || {
        echo "camgen: $1 is not set in ${CAMSHARE_CONF_LOADED}" >&2
        echo "        run 'make detect' first" >&2
        exit 1
    }
}

gen_udev() {
    need CAM_VENDOR
    need CAM_PRODUCT
    local serial_clause=""
    # Only match on serial when there is one. Many cameras report the same serial
    # for every unit, and a wrong match here means no symlink at all.
    [ -n "$CAM_SERIAL" ] && serial_clause=", ATTRS{serial}==\"$CAM_SERIAL\""
    cat <<EOF
# Generated by camgen from ${CAMSHARE_CONF_LOADED}. Do not edit by hand.
#
# Pins a stable /dev/$CAM_LINK symlink to the camera's capture node.
# ATTR{index}=="0" is essential: a UVC camera usually exposes a second,
# metadata-only node sharing the same vendor/product/serial, and without this
# the symlink can land on that one, which no application can ever use.
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="$CAM_VENDOR", ATTRS{idProduct}=="$CAM_PRODUCT"$serial_clause, ATTR{index}=="0", SYMLINK+="$CAM_LINK"
EOF
}

gen_modprobe() {
    local count numbers labels caps i
    count=$(camshare_count)
    numbers=$(camshare_numbers)
    labels=$(camshare_labels)
    [ "$count" -ge 1 ] || { echo "camgen: LOOPBACKS is empty" >&2; exit 1; }
    # exclusive_caps is per device, so it needs repeating: "1,1" for two.
    caps=""
    for ((i = 0; i < count; i++)); do caps="$caps,1"; done
    caps=${caps#,}
    cat <<EOF
# Generated by camgen from ${CAMSHARE_CONF_LOADED}. Do not edit by hand.
#
# exclusive_caps makes each loopback advertise Video Capture once something is
# streaming into it, which Chromium-based apps (Slack, Teams, Chrome) require
# before they will list the device at all.
options v4l2loopback devices=$count video_nr=$numbers card_label="$labels" exclusive_caps=$caps
EOF
}

case ${1:-} in
    udev)     gen_udev ;;
    modprobe) gen_modprobe ;;
    modules)  echo v4l2loopback ;;
    all)
        echo "--- udev ---";     gen_udev
        echo; echo "--- modprobe ---"; gen_modprobe
        ;;
    *) echo "usage: camgen {udev|modprobe|modules|all}" >&2; exit 2 ;;
esac
